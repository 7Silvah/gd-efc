# Copy to .env and fill in your values
# Puerto del servidor
PORT=3000

# Llave de cifrado AES-256 en base64 (32 bytes). Genérala con:
#   node -e "import('./shared/crypto.js').then(m => m.generateKey().then(console.log))"
EFC_KEY=

# OAuth Google (console.cloud.google.com -> APIs y servicios -> Credenciales)
# La URI de redirección http://127.0.0.1:53683/ debe estar registrada en el cliente OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Origen permitido para CORS (* = todos, como los templates originales)
CORS_ORIGIN=*

# Caché de respuestas /info en segundos (0 = desactivada)
CACHE_TTL_SECONDS=60

# Rate limiting: max peticiones POST por IP y ventana en segundos
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60
